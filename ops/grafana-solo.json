{
  "title": "Solo node",
  "uid": "solo-node",
  "description": "Chain progress, kernel calls, peers and the mempool of Solo nodes (spec 11).",
  "tags": [
    "solo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Node",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(solo_build_info, instance)",
        "query": {
          "query": "label_values(solo_build_info, instance)",
          "refId": "instance"
        },
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
