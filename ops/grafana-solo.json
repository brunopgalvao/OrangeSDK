      "title": "Kernel call latency (p99)",
      "description": "SoloKernelCallSlow fires when p99 stays above 1 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
