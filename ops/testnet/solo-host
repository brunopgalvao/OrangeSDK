#!/usr/bin/env bash
# solo-host: everything that happens on one host of a Solo network, one
# node per host. `solo-ops` runs it over ssh; systemd and the container run
# `solo-host run`. Every command is idempotent and prints what it did, so a
# configuration tool (Ansible, a shell loop) can call it as is.
#
# usage: solo-host <command> [args]
#
#   env                     the configuration it resolved
#   args                    the `solo node` command line `run` would exec
#   check-config            files present, key modes, the genesis hash the
#                           kernel computes is SOLO_GENESIS_HASH
#   run                     exec the node in the foreground (systemd, container)
#   start | stop | restart  through systemd, or as a background process
#   status                  running or not, and the node's /status
#   graceful-stop           solo_stop over the local JSON-RPC, then wait; a
#                           node that refuses it (--no-rpc-stop) gets SIGTERM
#   health [doctor flags]   `solo doctor` against the local JSON-RPC
#   finalized               "<height> <hash>" of the latest finalized block
#   block-hash <height>     the hash of a block
#   install-binary <file>   install a new `solo` beside the old, switch to it
#   rollback                switch back to the binary before
#   trust-key <rpc,...>     the group key those nodes agree on
#   logs [lines]            the node's recent log
#   backup-keys             a tar of the key directory on stdout
#   resources               pid, RSS, CPU time, data size, p2p bytes in/out
#
# Layout (every path under SOLO_ROOT, empty on a real host):
#   /opt/solo/bin/solo, solo-<hash>   the binaries, `solo` a symlink
#   /opt/solo/bin/solo-host           this script
#   /etc/solo/node.env                the node's configuration (below)
#   /etc/solo/genesis.json            the published genesis
#   /etc/solo/kernel.elf              the genesis kernel
#   /etc/solo/keys/validator.key      a validator's consensus key (0600), or
#   /etc/solo/keys/node.key           an observer's lasting node key (0600)
#   /var/lib/solo/                    the data directory: driver.state,
#                                     persist.log, chain.redb, peers.records,
#                                     snapshots/
#   /var/log/solo/node.log            the log in process mode (systemd: journald)
#   /run/solo/node.pid                the pid in process mode
#
# node.env (shell syntax, KEY=value, read by systemd too):
#   SOLO_ROLE=validator|rpc|bootnode  SOLO_NAME=<name>
#   SOLO_LISTEN=<ip:port to bind for peers>   SOLO_ADVERTISE=<ip:port peers dial>
#   SOLO_RPC=<private ip:port of JSON-RPC, /metrics, /status>
#   SOLO_BOOTSTRAP="<ip:port> ..."    beyond the genesis bootnodes
#   SOLO_GENESIS_HASH=0x...           the published hash check-config checks
#   SOLO_PUBLIC_RPC=1                 the RPC faces the public: no solo_stop
#   SOLO_JOIN=sync                    an empty data directory joins from the
#                                     peers' snapshots (spec 22 §7.4) ...
#   SOLO_TRUST_FROM=<rpc,...>         ... trusting the group key these nodes
#                                     agree on, or SOLO_TRUST_KEY=0x...
#   SOLO_SERVE_SNAPSHOTS=1            serve snapshots to joining nodes (default 1)
#   SOLO_STATE_HISTORY=<blocks> | SOLO_ARCHIVE=1
#   SOLO_MAX_PEERS, SOLO_OUTBOUND_PEERS, SOLO_EXTRA_ARGS
#
# Environment: SOLO_ROOT (default empty), SOLO_SERVICE (systemd | process;
# default systemd when systemctl exists), SOLO_BIN (default
# $SOLO_ROOT/opt/solo/bin/solo), SOLO_ENV (default /etc/solo/node.env).
set -euo pipefail

ROOT=${SOLO_ROOT:-}
ETC=$ROOT/etc/solo
DATA=$ROOT/var/lib/solo
OPT=$ROOT/opt/solo
LOGDIR=$ROOT/var/log/solo
RUNDIR=$ROOT/run/solo
ENV_FILE=${SOLO_ENV:-$ETC/node.env}
UNIT=solo-node
if [ -z "${SOLO_SERVICE:-}" ]; then
    if command -v systemctl >/dev/null 2>&1 && [ -z "$ROOT" ]; then
        SOLO_SERVICE=systemd
    else
        SOLO_SERVICE=process
    fi
fi

die() {
    printf 'solo-host: %s\n' "$*" >&2
    exit 1
}

load_env() {
    [ -f "$ENV_FILE" ] || die "$ENV_FILE: missing (solo-ops configure writes it)"
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
    SOLO_BIN=${SOLO_BIN:-$OPT/bin/solo}
    case "${SOLO_ROLE:-}" in
        validator | rpc | bootnode) ;;
        *) die "SOLO_ROLE must be validator, rpc or bootnode, not '${SOLO_ROLE:-}'" ;;
    esac
    [ -n "${SOLO_RPC:-}" ] || die "SOLO_RPC missing"
    [ -n "${SOLO_LISTEN:-}" ] || die "SOLO_LISTEN missing"
}

key_file() {
    if [ "$SOLO_ROLE" = validator ]; then
        echo "$ETC/keys/validator.key"
    else
        echo "$ETC/keys/node.key"
    fi
}

# One JSON-RPC call to the local node; prints the raw response.
rpc() {
    local method=$1 params=${2:-[]}
    curl -sf -m 10 -H 'content-type: application/json' \
        -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$method\",\"params\":$params}" \
        "http://$SOLO_RPC"
}

# The value of "field":"0x..." in JSON on stdin.
field() { sed -n "s/.*\"$1\":\"\\(0x[0-9a-fA-F]*\\)\".*/\\1/p" | head -n 1; }

chain_exists() { [ -f "$DATA/chain.redb" ]; }

# The `solo node` command line, one word per line.
node_args() {
    local key
    key=$(key_file)
    printf '%s\n' "$SOLO_BIN" node \
        --kernel "$ETC/kernel.elf" --genesis "$ETC/genesis.json" \
        --data-dir "$DATA" --listen "$SOLO_LISTEN" --rpc "$SOLO_RPC"
    if [ "$SOLO_ROLE" = validator ]; then
        printf '%s\n' --key-file "$key"
    elif [ -f "$key" ]; then
        printf '%s\n' --node-key-file "$key"
    fi
    [ -z "${SOLO_ADVERTISE:-}" ] || printf '%s\n' --advertise "$SOLO_ADVERTISE"
    local addr
    for addr in ${SOLO_BOOTSTRAP:-}; do
        printf '%s\n' --bootstrap "$addr"
    done
    [ -z "${SOLO_MAX_PEERS:-}" ] || printf '%s\n' --max-peers "$SOLO_MAX_PEERS"
    [ -z "${SOLO_OUTBOUND_PEERS:-}" ] || printf '%s\n' --outbound-peers "$SOLO_OUTBOUND_PEERS"
    [ "${SOLO_SERVE_SNAPSHOTS:-1}" != 1 ] || printf '%s\n' --serve-snapshots
    [ "${SOLO_PUBLIC_RPC:-0}" != 1 ] || printf '%s\n' --no-rpc-stop
    if [ "${SOLO_ARCHIVE:-0}" = 1 ]; then
        printf '%s\n' --archive
    elif [ -n "${SOLO_STATE_HISTORY:-}" ]; then
        printf '%s\n' --state-history "$SOLO_STATE_HISTORY"
    fi
    # A node with nothing on disk yet joins from its peers' snapshots.
    if [ "${SOLO_JOIN:-}" = sync ] && ! chain_exists; then
        printf '%s\n' --sync-from-peers
        local trust=${SOLO_TRUST_KEY:-}
        if [ -z "$trust" ] && [ -n "${SOLO_TRUST_FROM:-}" ]; then
            trust=$("$SOLO_BIN" snapshot trust-key --rpc "$SOLO_TRUST_FROM")
        fi
        [ -z "$trust" ] || printf '%s\n' --trust-key "$trust"
    fi
    local extra
    for extra in ${SOLO_EXTRA_ARGS:-}; do
        printf '%s\n' "$extra"
    done
}

pid_of() {
    local pid
    pid=$(cat "$RUNDIR/node.pid" 2>/dev/null) || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    echo "$pid"
}

running() {
    if [ "$SOLO_SERVICE" = systemd ]; then
        systemctl is-active --quiet "$UNIT"
    else
        pid_of >/dev/null
    fi
}

wait_gone() {
    local deadline=$((SECONDS + ${1:-60}))
    while running; do
        [ "$SECONDS" -lt "$deadline" ] || return 1
        sleep 0.5
    done
}

graceful_stop() {
    # The process, in process mode; systemd's MAINPID for ExecStop.
    local pid=${MAINPID:-}
    [ -n "$pid" ] || pid=$(pid_of) || return 0
    if rpc solo_stop | grep -q '"result":true'; then
        local deadline=$((SECONDS + 60))
        while kill -0 "$pid" 2>/dev/null; do
            [ "$SECONDS" -lt "$deadline" ] || break
            sleep 0.5
        done
    fi
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
        local deadline=$((SECONDS + 30))
        while kill -0 "$pid" 2>/dev/null; do
            [ "$SECONDS" -lt "$deadline" ] || {
                kill -KILL "$pid" 2>/dev/null || true
                break
            }
            sleep 0.5
        done
    fi
    rm -f "$RUNDIR/node.pid"
}

start() {
    if running; then
        echo "$SOLO_NAME: already running"
        return 0
    fi
    if [ "$SOLO_SERVICE" = systemd ]; then
        systemctl start "$UNIT"
    else
        mkdir -p "$LOGDIR" "$RUNDIR"
        local log=$LOGDIR/node.log
        # Keep one older log: process mode has no journald.
        if [ -f "$log" ] && [ "$(wc -c <"$log")" -gt 104857600 ]; then
            mv "$log" "$log.1"
        fi
        nohup "$0" run >>"$log" 2>&1 </dev/null &
        echo $! >"$RUNDIR/node.pid"
    fi
    echo "$SOLO_NAME: started"
}

stop() {
    if [ "$SOLO_SERVICE" = systemd ]; then
        systemctl stop "$UNIT"
    else
        graceful_stop
    fi
    echo "$SOLO_NAME: stopped"
}

check_config() {
    local missing=0 f
    for f in "$ETC/genesis.json" "$ETC/kernel.elf" "$SOLO_BIN"; do
        [ -e "$f" ] || {
            echo "missing: $f" >&2
            missing=1
        }
    done
    local key
    key=$(key_file)
    if [ "$SOLO_ROLE" = validator ] && [ ! -f "$key" ]; then
        echo "missing: $key (the operator puts the validator key there)" >&2
        missing=1
    fi
    [ "$missing" = 0 ] || die "configuration incomplete"
    if [ -f "$key" ]; then
        local mode
        mode=$(stat -c %a "$key" 2>/dev/null || stat -f %Lp "$key")
        [ "$mode" = 600 ] || [ "$mode" = 400 ] || die "$key: mode $mode, must be 600 or 400"
    fi
    local hash
    hash=$("$SOLO_BIN" genesis hash --genesis "$ETC/genesis.json" --kernel "$ETC/kernel.elf")
    if [ -n "${SOLO_GENESIS_HASH:-}" ] && [ "$hash" != "$SOLO_GENESIS_HASH" ]; then
        die "genesis hash $hash is not the published $SOLO_GENESIS_HASH"
    fi
    echo "$SOLO_NAME: configuration ok, $SOLO_ROLE, genesis $hash"
}

resources() {
    local pid rss=0 cpu=0 data in=0 out=0
    pid=$(if [ "$SOLO_SERVICE" = systemd ]; then
        systemctl show -p MainPID --value "$UNIT"
    else
        pid_of || echo 0
    fi)
    if [ "${pid:-0}" != 0 ]; then
        rss=$(ps -o rss= -p "$pid" | tr -d ' ')
        cpu=$(ps -o time= -p "$pid" | tr -d ' ')
    fi
    data=$(du -sk "$DATA" 2>/dev/null | cut -f1)
    local metrics
    if metrics=$(curl -sf -m 10 "http://$SOLO_RPC/metrics"); then
        in=$(awk '$1 ~ /^solo_p2p_bytes_total/ && $1 ~ /"in"/ { print $2 }' <<<"$metrics")
        out=$(awk '$1 ~ /^solo_p2p_bytes_total/ && $1 ~ /"out"/ { print $2 }' <<<"$metrics")
    fi
    echo "name=$SOLO_NAME pid=${pid:-0} rss_kib=${rss:-0} cpu=${cpu:-0} data_kib=${data:-0} p2p_in_bytes=${in:-0} p2p_out_bytes=${out:-0}"
}

command=${1:-}
[ -n "$command" ] || die "usage: solo-host <command> (see the header of this script)"
shift

case "$command" in
    install-binary)
        file=${1:?install-binary <file>}
        mkdir -p "$OPT/bin"
        sum=$( (sha256sum "$file" 2>/dev/null || shasum -a 256 "$file") | cut -c1-12)
        target=$OPT/bin/solo-$sum
        install -m 0755 "$file" "$target"
        if [ -L "$OPT/bin/solo" ] && [ "$(readlink "$OPT/bin/solo")" != "solo-$sum" ]; then
            ln -sfn "$(readlink "$OPT/bin/solo")" "$OPT/bin/solo.previous"
        fi
        ln -sfn "solo-$sum" "$OPT/bin/solo"
        echo "solo-$sum installed"
        exit 0
        ;;
    rollback)
        [ -L "$OPT/bin/solo.previous" ] || die "no previous binary"
        prev=$(readlink "$OPT/bin/solo.previous")
        cur=$(readlink "$OPT/bin/solo")
        ln -sfn "$prev" "$OPT/bin/solo"
        ln -sfn "$cur" "$OPT/bin/solo.previous"
        echo "back to $prev (restart the node)"
        exit 0
        ;;
esac

load_env
case "$command" in
    env)
        echo "root=${ROOT:-/} service=$SOLO_SERVICE env=$ENV_FILE bin=$SOLO_BIN data=$DATA"
        grep -E '^SOLO_' "$ENV_FILE"
        ;;
    args) node_args ;;
    check-config) check_config ;;
    run)
        args=()
        while IFS= read -r word; do args+=("$word"); done < <(node_args)
        exec "${args[@]}"
        ;;
    start) start ;;
    stop) stop ;;
    restart)
        stop
        start
        ;;
    graceful-stop) graceful_stop ;;
    status)
        if running; then
            echo "$SOLO_NAME: running"
            curl -sf -m 10 "http://$SOLO_RPC/status" && echo
        else
            echo "$SOLO_NAME: stopped"
            exit 3
        fi
        ;;
    health) "$SOLO_BIN" doctor --rpc "$SOLO_RPC" "$@" ;;
    finalized)
        body=$(rpc eth_getBlockByNumber '["finalized",false]') || die "$SOLO_RPC does not answer"
        number=$(field number <<<"$body")
        echo "$((number)) $(field hash <<<"$body")"
        ;;
    block-hash)
        height=${1:?block-hash <height>}
        body=$(rpc eth_getBlockByNumber "[\"$(printf '0x%x' "$height")\",false]") || die "$SOLO_RPC does not answer"
        field hash <<<"$body"
        ;;
    trust-key) "$SOLO_BIN" snapshot trust-key --rpc "${1:?trust-key <rpc,...>}" ;;
    logs)
        lines=${1:-200}
        if [ "$SOLO_SERVICE" = systemd ]; then
            journalctl -u "$UNIT" -n "$lines" --no-pager
        else
            tail -n "$lines" "$LOGDIR/node.log"
        fi
        ;;
    backup-keys) tar -C "$ETC" -cf - keys ;;
    resources) resources ;;
    *) die "unknown command $command" ;;
esac
